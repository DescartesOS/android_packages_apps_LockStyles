package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "LunarisLockStyles",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "kotlinx_coroutines_android",
    ],
    kotlincflags: ["-Xjvm-default=all"],
    optimize: {
        enabled: false,
    },
    required: [
        "privapp_whitelist_org.lunaris.lockstyles",
        "default-permissions_org.lunaris.lockstyles",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_org.lunaris.lockstyles",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp_whitelist_org.lunaris.lockstyles.xml",
    filename_from_src: true,
}

prebuilt_etc {
    name: "default-permissions_org.lunaris.lockstyles",
    system_ext_specific: true,
    sub_dir: "default-permissions",
    src: "default-permissions_org.lunaris.lockstyles.xml",
    filename_from_src: true,
}
