<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lunaris.lockstyles">

    <uses-permission android:name="android.permission.CHANGE_OVERLAY_PACKAGES" />
    <uses-permission android:name="android.permission.CUSTOMIZE_SYSTEM_UI" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_WALLPAPER_INTERNAL" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_COMPONENT" />
    <uses-permission android:name="android.permission.STATUS_BAR_SERVICE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.WRITE_MEDIA_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="org.omnirom.omnijaws.READ_WEATHER" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:usesNonSdkApi="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".ui.LockScreenGalleryActivity"
            android:enabled="true"
            android:label="@string/gallery_title"
            android:theme="@style/Theme.LockStyles"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="org.lunaris.lockstyles.lockscreens">
            <intent-filter>
                <action android:name="com.android.wallpaper.action.LOCK_SCREENS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.ui.LockSettingsActivity"
            android:label="@string/lock_settings"
            android:theme="@style/Theme.LockStyles.Settings"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="org.lunaris.lockstyles.action.LOCK_SCREEN_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service android:name=".WallpaperSubjectExtractorService" android:exported="false" />
        <service
            android:name=".GalleryWallpaperService"
            android:label="@string/gallery_live_wallpaper"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/gallery_wallpaper" />
        </service>
        <service
            android:name=".GalleryEffectService"
            android:label="@string/gallery_effects_wallpaper"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/gallery_wallpaper" />
        </service>
        <provider
            android:name=".DepthSubjectProvider"
            android:authorities="org.lunaris.lockstyles.depth"
            android:exported="true"
            android:readPermission="android.permission.READ_WALLPAPER_INTERNAL" />
    </application>
</manifest>
